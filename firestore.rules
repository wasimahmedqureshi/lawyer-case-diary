rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each advocate can only see and change their own cases
    match /cases/{caseId} {
      allow create: if request.auth != null
                    && request.resource.data.advocateId == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.advocateId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.advocateId == request.auth.uid
                    && request.resource.data.advocateId == request.auth.uid;
    }

    // Case-number counter (one document per advocate)
    match /counters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Advocate profile
    match /advocates/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
